# Copy to .env and change what you need. Every line is optional; these are the defaults.
# Keep .env out of git (it is in .gitignore).

# Login tokens are signed with this. Use a long random value when the app is on the internet:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-before-deploying
ACCESS_TOKEN_MINUTES=480

# AI engines (inside the app). true = instant fake answers (no models), for building screens.
OCR_MOCK=false
VOICE_MOCK=false
# Whisper size: base (fast, weaker Urdu) | small (default) | medium
WHISPER_MODEL=small
# Load Whisper when the app starts (false: on the first voice question)
VOICE_PRELOAD=true
# OCR engine down: read CNICs with Tesseract (only if Tesseract is installed)
LOCAL_OCR_FALLBACK=true
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# DATABASE_URL=sqlite:///./lastmile.db
# UPLOAD_DIR=uploads
# Whisper: small (fast, default) or turbo (large-v3-turbo: better Urdu spelling, ~2x slower).
# Uses models\whisper-* from tools\fetch_models.ps1 when present.
# WHISPER_MODEL=turbo
# The meaning model (models\meaning) is used automatically when present; MEANING_OFF=1 turns it off.
# MEANING_OFF=1
